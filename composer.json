{
    "name": "andydefer/php-locationiq",
    "description": "PHP SDK for LocationIQ and Nominatim APIs: balance, timezone, directions, and reverse geocoding with typed requests, responses, and data objects",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "AndyDefer\\PhpLocationIq\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AndyDefer\\PhpLocationIq\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Andy Kani",
            "email": "andykanidimbu@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "andydefer/php-services": "^1.6.29",
        "jenssegers/agent": "^2.6"
    },
    "require-dev": {
        "larastan/larastan": "^3.8",
        "laravel/pint": "^1.26",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "*",
        "symfony/var-dumper": "^7.0",
        "vimeo/psalm": "^6.14",
        "guzzlehttp/guzzle": "^7.8"
    }
}